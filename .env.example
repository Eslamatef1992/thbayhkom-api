# Server
NODE_ENV=development
PORT=3000
API_BASE_PATH=/api

# Database (Postgres in prod, matching the leader's schema)
DB_DIALECT=postgres          # sqlite | postgres
DB_STORAGE=./data/dev.sqlite # used only when DB_DIALECT=sqlite
DATABASE_URL=postgres://thabayehkom_user:password@127.0.0.1:5432/thabayehkom_db
DB_SYNC=true                 # dev only: sequelize.sync; use SQL/migrations in prod

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=90d
BCRYPT_ROUNDS=10

# Assets
PUBLIC_ASSET_BASE_URL=https://thabayehkom.app/storage

# Payments (gateway provider TBD - see docs Q1). COD works without these.
PAYMENT_SUCCESS_URL=https://thabayehkom.com/{lang}/successpayment
PAYMENT_FAIL_URL=https://thabayehkom.com/{lang}/failpayment

# CORS (comma-separated origins for the web build / admin dashboard)
WEB_CORS_ORIGINS=*

# Social auth (optional; verification is best-effort if libs/keys absent)
GOOGLE_OAUTH_CLIENT_IDS=

# Initial admin seed
ADMIN_EMAIL=admin@thabayehkom.app
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=Super Admin
ADMIN_MOBILE=96500000000

# Mailgun (order confirmation + status emails)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=mg.thabayehkom.app
MAILGUN_FROM=Thabayehkom <support@mg.thabayehkom.app>
MAILGUN_EU_REGION=false

# Uploads
UPLOAD_DIR=./uploads
UPLOAD_MAX_FILE_MB=5
# Optional absolute base for returned URLs; when empty the request host is used.
UPLOAD_PUBLIC_BASE_URL=
