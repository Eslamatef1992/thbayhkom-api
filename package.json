{
  "name": "thabayhkom-backend",
  "version": "1.0.0",
  "description": "Node.js/TypeScript API for the Thabayehkom Flutter app + admin dashboard",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts",
    "seed": "ts-node src/db/seed.ts",
    "seed:prod": "node dist/db/seed.js",
    "test": "jest --runInBand"
  },
  "keywords": [
    "flutter",
    "api",
    "backend",
    "admin"
  ],
  "author": "Thabayehkom Team",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "2.4.3",
    "cors": "2.8.5",
    "dotenv": "16.3.1",
    "express": "4.18.2",
    "express-rate-limit": "6.11.2",
    "helmet": "7.1.0",
    "joi": "17.11.0",
    "jsonwebtoken": "9.0.2",
    "morgan": "1.10.0",
    "multer": "^2.0.1",
    "pg": "8.11.3",
    "pg-hstore": "2.3.4",
    "sequelize": "6.35.2",
    "sqlite3": "5.1.7",
    "swagger-ui-express": "5.0.0"
  },
  "optionalDependencies": {
    "google-auth-library": "9.4.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/jest": "29.5.11",
    "@types/jsonwebtoken": "9.0.5",
    "@types/morgan": "1.9.9",
    "@types/multer": "1.4.11",
    "@types/node": "20.10.6",
    "@types/supertest": "6.0.2",
    "@types/swagger-ui-express": "4.1.6",
    "jest": "29.7.0",
    "supertest": "6.3.3",
    "ts-jest": "29.1.1",
    "ts-node": "10.9.2",
    "typescript": "5.3.3"
  }
}
